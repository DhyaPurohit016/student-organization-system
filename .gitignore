# Secrets: each machine keeps its own .env (copy server/.env.example to start)
.env
.env.*
!.env.example

# Installed packages (recreate with `npm install`)
node_modules/

# Build output and caches
dist/
.vite/

# Files people upload while using the app (receipts, posters, logos)
server/uploads/*
!server/uploads/.gitkeep

# Editor and OS clutter
.DS_Store
Thumbs.db
*.log
