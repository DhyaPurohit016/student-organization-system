PORT=5000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@club.com
ADMIN_PASSWORD=change-me-min-8-chars

# Payments: "mock" = test mode checkout
PAYMENT_PROVIDER=mock

# Email: leave SMTP_HOST empty to log emails to the console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusClubs <no-reply@campusclubs.test>

# MySQL (the database is created automatically if it does not exist)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_org
DB_USER=root
DB_PASSWORD=root
# Set to true once after a phase adds columns to existing tables
DB_SYNC_ALTER=false

# How long a checkout holds seats/stock while the buyer pays (minutes)
CHECKOUT_HOLD_MINUTES=15

# Password for the demo accounts created by npm run seed:demo (development only)
DEMO_PASSWORD=Demo@12345

# Razorpay (set PAYMENT_PROVIDER=razorpay above to use it)
# Keys: Razorpay Dashboard > Account & Settings > API Keys (use rzp_test_ keys while testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: Dashboard > Webhooks > URL https://<your-api>/api/payments/webhook/razorpay,
# events payment.captured + order.paid; paste the secret you choose here
RAZORPAY_WEBHOOK_SECRET=
